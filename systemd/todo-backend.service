[Unit]
Description=Enterprise Task Management Backend Service
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/todo-backend
Environment="PORT=8000"
Environment="ALLOWED_ORIGINS=http://localhost"
ExecStart=/opt/todo-backend/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
